PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/venzy
# Set true if your hosted PostgreSQL requires TLS
DATABASE_SSL=true
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REPLACE_ME
MERCADOPAGO_WEBHOOK_SECRET=REPLACE_ME
# JWT secret from the Venzy authentication service; do not use a public/static secret
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
APP_BASE_URL=https://your-venzy-domain.example
